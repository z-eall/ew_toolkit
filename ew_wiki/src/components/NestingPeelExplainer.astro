---
// A plain Astro component (no UI framework) — same construction pattern as
// TriggerChangeExplainer.astro: class-scoped (not id-scoped) so more than
// one instance can coexist, client-side <script> does the evaluation, no
// client:load needed.
//
// Validated as a throwaway HTML prototype first.
// An early round used a free-text name input; maintainer feedback swapped
// it for a 3-scenario dropdown, which also dropped the separate "Example: ..."
// preview line as redundant (every option's own text already names the
// example, e.g. "Ragnar (6 chars)", and none truncate inside the select)
// and reserved min-height on the narration/result zones (a floor, not a
// hard height+overflow:hidden ceiling -- that first attempt silently
// clipped the longest result sentence on a narrow mobile viewport, caught
// by actually resizing to mobile and reading the text, not assumed safe
// from a desktop screenshot). Round 3 dropped Back/Next's arrow glyphs and
// the "Step X of 3" label entirely (both flagged as redundant/noisy). The
// real cause of Back sitting out of line with Next/Reset (confirmed via
// getBoundingClientRect, not guessed) turned out to be Starlight's own
// global CSS handing every non-first button a stray margin-top:16px -- the
// same recurring bug already fought in FilterLimitExplainer.astro and
// ObjectsNearbyExplainer.astro -- not a height mismatch; margin:0 on every
// button fixes it. An explicit button height stays too, as a second,
// independent guarantee against :disabled reintroducing a height
// difference later.
//
// The 3 scenarios are deliberately chosen to show all three shapes the
// clamp can produce:
//   - "Ragnar" (6 chars)                          -> budget 14  (plain, no clamp)
//   - "Bjorn Ironsideson II" (20 chars)            -> budget 0   (exactly at the
//     limit -- max_0_0 is still 0, so this is the "not negative, nothing to
//     clamp" case, distinct from the case below on purpose)
//   - "Ragnar the Unbroken of Northshire" (33 chars) -> budget -13, clamped to
//     0 -- the actual <max_0_X> clamp firing, the whole reason that layer
//     exists.
//
// Spacing mirrors TriggerChangeExplainer.astro's numbers (12px horizontal),
// tightened further this round per the maintainer's "minimal spacing, no
// gaps between lines" note -- measured against this widget's own content,
// not guessed further down from another widget.
---

<div class="np-widget">
	<h4>Peel it from the inside out</h4>
	<p class="np-sub">A nested function resolves its <em>innermost</em> call first — not left to right. Pick a name, then step through to see it happen.</p>

	<div class="np-zone-input">
		<label>&lt;par_1&gt;</label>
		<select data-ctl="name">
			<option value="Ragnar" selected>Ragnar (6 chars)</option>
			<option value="Bjorn Ironsideson II">Bjorn Ironsideson II (20 chars)</option>
			<option value="Ragnar the Unbroken of Northshire">Ragnar the Unbroken of Northshire (33 chars)</option>
		</select>
	</div>

	<div class="np-zone-expr">
		<p class="np-expr" data-expr></p>
	</div>

	<div class="np-zone-narration">
		<p class="np-narration-text" data-narration></p>
		<p class="np-result-line" data-result></p>
	</div>

	<div class="np-zone-controls">
		<button type="button" data-back>Back</button>
		<button type="button" data-next>Next</button>
		<button type="button" data-reset>Reset</button>
	</div>
</div>

<style>
	.np-widget {
		--np-active: #e6c18a;
		--np-done: #7fa8bf;
		--np-final: #8fbf7f;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: 6px;
		margin: 1rem 0;
		font-size: 14px;
		overflow: hidden;
	}
	:global(html[data-theme='light']) .np-widget {
		--np-active: #8a5a12;
		--np-done: #2c5f78;
		--np-final: #2f5233;
	}
	.np-widget h4 { margin: 0; padding: 8px 12px 0; font-size: 0.95em; color: var(--text); line-height: 1.3; }
	.np-sub { margin: 0; padding: 2px 12px 6px; color: var(--muted); font-size: 0.9em; line-height: 1.35; }

	.np-zone-input {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 12px;
		margin: 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}
	.np-zone-input label {
		margin: 0;
		font-size: 11.5px;
		font-weight: 600;
		color: var(--muted);
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		flex: none;
	}
	.np-zone-input select {
		margin: 0;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text);
		border-radius: 5px;
		padding: 4px 6px;
		font-size: 13px;
		font-family: inherit;
		flex: 1 1 auto;
		min-width: 0;
	}

	/* min-height, not a hard height -- now that the unresolved <len_X> shows
	   the real name (Bjorn Ironsideson II in full, the 33-char name
	   shortened to "Ragnar ... Northshire"), the longest embedded name can
	   push this line onto 2 lines at mobile width. Same floor-not-ceiling
	   fix already applied to the narration/result zones below, for the
	   same reason: a hard height clipped real content there. */
	.np-zone-expr { padding: 6px 12px; margin: 0; min-height: 2.2em; display: flex; align-items: center; justify-content: center; }
	.np-expr {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 14px;
		line-height: 1.3;
		word-break: break-word;
		margin: 0;
		text-align: center;
	}
	.np-expr :global(.np-fn-active) {
		color: var(--np-active);
		background: color-mix(in srgb, var(--np-active) 20%, transparent);
		border-radius: 4px;
		padding: 1px 3px;
	}
	.np-expr :global(.np-chip-done) {
		color: var(--np-done);
		background: color-mix(in srgb, var(--np-done) 20%, transparent);
		border-radius: 4px;
		padding: 1px 4px;
		font-weight: 600;
	}
	.np-expr :global(.np-chip-final) {
		color: var(--np-final);
		background: color-mix(in srgb, var(--np-final) 20%, transparent);
		border-radius: 4px;
		padding: 1px 5px;
		font-weight: 700;
	}
	.np-expr :global(.np-par-chip) { color: var(--text); font-weight: 600; }
	.np-expr :global(.np-fn-open) { color: var(--muted); }

	.np-zone-narration { padding: 6px 12px 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
	/* Reserved for the longest real narration string across all 3 scenarios
	   x 4 steps (the step-2 subtraction sentence with the 33-char name is
	   the tallest, wrapping to 3 lines at the widget's own desktop width)
	   -- min-height, a FLOOR not a ceiling: it stops normal desktop
	   stepping from resizing the widget, but still lets the box grow
	   instead of clipping text on a narrow viewport where the same
	   sentence wraps further. A hard height + overflow:hidden was tried
	   first and silently cut off the tail of the longest result sentence
	   at mobile width -- caught in a real mobile-viewport check, not
	   assumed safe from the desktop screenshot alone. */
	.np-narration-text { margin: 0; font-size: 12.5px; color: var(--text); line-height: 1.4; min-height: 3.9em; }
	.np-narration-text :global(code) {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		color: var(--np-active);
	}
	/* Reserved for the longest final-result sentence (the 33-char name,
	   uppercased, can wrap to 2 lines on desktop, 3 on mobile) -- same
	   floor-not-ceiling reasoning as above. */
	.np-result-line { margin: 0; font-size: 12.5px; font-weight: 700; color: var(--np-final); line-height: 1.35; min-height: 2.7em; }

	.np-zone-controls { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 6px 12px 8px; margin: 0; }
	/* margin:0 here is load-bearing, not decorative -- confirmed via
	   getBoundingClientRect that Starlight's own global CSS was giving every
	   non-first button here a stray margin-top:16px (Back, the first child,
	   got 0), pushing Next/Reset down inside the flex row even with
	   align-items:center on the parent. Same recurring "stray external
	   margin from outside this component" bug documented in
	   FilterLimitExplainer.astro/ObjectsNearbyExplainer.astro -- zeroing it
	   explicitly is the established fix, not a new one. The explicit height
	   (not just padding+line-height) additionally guarantees all 3 buttons
	   share one box height regardless of :disabled's own rendering quirks. */
	.np-zone-controls button {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		height: 26px;
		margin: 0;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--text);
		border-radius: 6px;
		padding: 0 12px;
		font-size: 12.5px;
		font-weight: 600;
		line-height: 1;
		cursor: pointer;
	}
	.np-zone-controls button:disabled { opacity: 0.4; cursor: default; }
	.np-zone-controls button:not(:disabled):hover { border-color: var(--text); }
</style>

<script>
	interface Values {
		len: number;
		budget: number;
		result: number;
	}

	const TOTAL_STEPS = 3;

	function computeValues(name: string): Values {
		const len = name.length;
		const budget = 20 - len;
		const result = Math.max(0, budget);
		return { len, budget, result };
	}

	// Names past 20 chars get shortened to "first ... last" inside the
	// expression box only (never in the narration/result text, which keep
	// the real full name) -- otherwise the 33-char scenario's unresolved
	// <len_X> call pushes the whole expression onto 2 lines, which is what
	// the fixed-height .np-zone-expr box exists to avoid. Names at or under
	// 20 chars (both other scenarios) always show in full, per the
	// maintainer's explicit call on the Bjorn case.
	function displayName(name: string): string {
		if (name.length <= 20) return name;
		const words = name.trim().split(/\s+/);
		if (words.length < 2) return name;
		return words[0] + ' ... ' + words[words.length - 1];
	}

	function renderExpr(s: number, name: string, v: Values): string {
		// Layer 1: <len_X> -- shows the real (possibly shortened) name until
		// it resolves, matching the validated prototype's behavior; not the
		// literal placeholder "<par_1>".
		let layer1: string;
		if (s >= 1) {
			layer1 = '<span class="np-chip-done">' + v.len + '</span>';
		} else {
			layer1 = '<span class="np-fn-active">&lt;len_<span class="np-par-chip">' + displayName(name) + '</span>&gt;</span>';
		}

		// Layer 2: <sub_20_LAYER1>
		let layer2: string;
		if (s >= 2) {
			layer2 = '<span class="np-chip-done">' + v.budget + '</span>';
		} else {
			const cls = s === 1 ? 'np-fn-active' : 'np-fn-open';
			layer2 = '<span class="' + cls + '">&lt;sub_20_' + layer1 + '&gt;</span>';
		}

		// Layer 3: <max_0_LAYER2>
		let layer3: string;
		if (s >= 3) {
			layer3 = '<span class="np-chip-final">' + v.result + '</span>';
		} else {
			const cls = s === 2 ? 'np-fn-active' : 'np-fn-open';
			layer3 = '<span class="' + cls + '">&lt;max_0_' + layer2 + '&gt;</span>';
		}

		return layer3;
	}

	const NARRATIONS: ((name: string, v: Values) => string)[] = [
		() => 'The whole thing is one function wrapped in another, wrapped in another. The <code>&lt;len_X&gt;</code> call — innermost, highlighted — goes first.',
		(name, v) => '<code>&lt;len_X&gt;</code> counted the characters: "' + name + '" is ' + v.len + ' character(s) long. Now <code>&lt;sub_20_X&gt;</code> — highlighted — takes a turn.',
		(name, v) =>
			'<code>&lt;sub_20_X&gt;</code> subtracted that from the 20-character budget: 20 − ' +
			v.len +
			' = ' +
			v.budget +
			(v.budget < 0 ? ' (over budget — a negative number).' : '.') +
			' Now <code>&lt;max_0_X&gt;</code> — highlighted — takes the last turn.',
		() => '<code>&lt;max_0_X&gt;</code> clamps a negative budget up to 0, so the reader never sees a negative "characters left." Fully resolved.',
	];

	for (const widget of document.querySelectorAll<HTMLElement>('.np-widget')) {
		const nameSel = widget.querySelector<HTMLSelectElement>('[data-ctl="name"]')!;
		const exprEl = widget.querySelector<HTMLElement>('[data-expr]')!;
		const narrationEl = widget.querySelector<HTMLElement>('[data-narration]')!;
		const resultEl = widget.querySelector<HTMLElement>('[data-result]')!;
		const backBtn = widget.querySelector<HTMLButtonElement>('[data-back]')!;
		const nextBtn = widget.querySelector<HTMLButtonElement>('[data-next]')!;
		const resetBtn = widget.querySelector<HTMLButtonElement>('[data-reset]')!;

		let step = 0;

		function render() {
			const name = nameSel.value;
			const v = computeValues(name);
			exprEl.innerHTML = renderExpr(step, name, v);
			narrationEl.innerHTML = NARRATIONS[step](name, v);
			resultEl.textContent =
				step === TOTAL_STEPS ? 'Registered as ' + name.toUpperCase() + ' — ' + v.result + ' character(s) left before the 20-limit.' : '';
			backBtn.disabled = step === 0;
			nextBtn.disabled = step === TOTAL_STEPS;
		}

		nameSel.addEventListener('change', () => {
			step = 0;
			render();
		});
		backBtn.addEventListener('click', () => {
			if (step > 0) step -= 1;
			render();
		});
		nextBtn.addEventListener('click', () => {
			if (step < TOTAL_STEPS) step += 1;
			render();
		});
		resetBtn.addEventListener('click', () => {
			step = 0;
			render();
		});

		render();
	}
</script>
