---
// A plain Astro component (no UI framework) — same construction pattern as
// WeightLotteryExplainer.astro / TriggerChangeExplainer.astro: class-scoped
// (never id-scoped) so more than one instance can coexist, client-side
// <script> does the work, no client:load needed.
//
// Prototyped first (ticket 22, world-level-dial-v1-prototype.html, branch
// prototype/world-level-dial-widget) to answer a real design fork before
// building: instead of a separate slider per page (independent state, no
// felt connection between the 3 pages) or a real cross-page persistence
// mechanism (localStorage — can silently reset in a private window or
// cleared history, confusing more than it helps), this is ONE widget with
// 3 tabs (Boss Progression / Auto-upgrade Stations / Village Cargo)
// sharing a single 0-8 bfvworldlevel slider, dropped into all 3 real pages
// via this one shared component. Flipping tabs shows all 3 systems react
// to the same number without leaving the page.
//
// Table data confirmed straight from the 3 real pages this widget sits on
// (world-progression.mdx, auto-upgrade-station.mdx, village-cargo.mdx) —
// not re-derived or guessed. bfvworldlevel range is 0-8: boss tiers only
// go 1-7 (one per real boss), so level 8 is a genuine fallback/overflow no
// boss kill can ever produce; the station and cargo tables both cap at
// level 6, so 7-8 fall back to that same max tier. Auto-upgrade Stations'
// own feast-table section was intentionally left out of this widget —
// not important for the dial demo, real page still covers it in prose.
//
// defaultTab lets each page open the widget already on its own topic
// (confirmed feasible in the prototype via a ?page= stand-in) — falls back
// to "progression" if a page doesn't pass one.
//
// Known-bug guard (same class of bug hit on WeightLotteryExplainer's tally
// rows): every table row/tag this widget renders is built via
// el.innerHTML = "...", so those elements never carry Astro's own scoping
// class — every such rule below must be :global(...) or it silently
// matches nothing.

interface Props {
	defaultTab?: 'progression' | 'stations' | 'cargo';
}
const { defaultTab = 'progression' } = Astro.props;
---

<div class="wld-widget" data-default-tab={defaultTab}>
	<h4>World Level Dial</h4>
	<p class="wld-sub" data-sub></p>

	<div class="wld-tabs">
		<button type="button" class="wld-tab" data-tab="progression">Boss Progression</button>
		<button type="button" class="wld-tab" data-tab="stations">Auto-upgrade Stations</button>
		<button type="button" class="wld-tab" data-tab="cargo">Village Cargo</button>
	</div>

	<div class="wld-slider-card">
		<div class="wld-slider-row">
			<label for={`wld-slider-${defaultTab}`}>bfvworldlevel</label>
			<input type="range" id={`wld-slider-${defaultTab}`} class="wld-slider" min="0" max="8" step="1" value="0" />
			<span class="wld-level-readout" data-readout>0</span>
		</div>
		<p class="wld-level-caption" data-caption></p>
	</div>

	<div class="wld-result" data-result></div>
</div>

<style>
	.wld-widget {
		--wld-ok: #8fbf7f;
		--wld-fallback: #e0a458;
		--wld-fallback-text: #2a1a05;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 12px 14px;
		margin: 1rem 0;
		font-size: 13.5px;
	}
	:global(html[data-theme='light']) .wld-widget {
		--wld-ok: #2f5233;
		--wld-fallback: #8a5a12;
		--wld-fallback-text: #dfd0b8;
	}
	.wld-widget h4 {
		margin: 0 0 3px;
		font-size: 0.95em;
		color: var(--text);
	}
	.wld-sub {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 0.9em;
	}

	.wld-tabs {
		display: flex;
		gap: 6px;
		margin: 0 0 10px;
	}
	.wld-tab {
		margin: 0;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--muted);
		border-radius: 5px;
		padding: 4px 10px;
		font-size: 12.5px;
		font-weight: 600;
		cursor: pointer;
		flex: 1;
	}
	.wld-tab:hover {
		color: var(--text);
	}
	.wld-tab.wld-tab-active {
		background: var(--bg);
		border-color: var(--text);
		color: var(--text);
	}

	.wld-slider-card {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 5px;
		padding: 10px;
		margin: 0 0 10px;
	}
	.wld-slider-row {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.wld-slider-row label {
		margin: 0;
		font-size: 12.5px;
		font-weight: 600;
		color: var(--text);
		white-space: nowrap;
	}
	.wld-slider {
		margin: 0;
		flex: 1;
	}
	.wld-level-readout {
		margin: 0;
		min-width: 26px;
		text-align: center;
		font-weight: 700;
		font-size: 14px;
		color: var(--text);
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 2px 6px;
	}
	.wld-level-caption {
		margin: 6px 0 0;
		font-size: 12px;
		color: var(--muted);
	}

	.wld-result {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 5px;
		padding: 10px;
	}

	/* :global — every rule below targets elements the client <script> builds
	   via el.innerHTML = "..." (table rows, tags), none of which carry
	   Astro's own scoping class. A plain selector here silently matches
	   nothing — the exact bug class WeightLotteryExplainer's tally rows
	   already warn about. */
	:global(.wld-result table) {
		width: 100%;
		table-layout: fixed;
		border-collapse: collapse;
		font-size: 12px;
	}
	:global(.wld-result th),
	:global(.wld-result td) {
		text-align: left;
		padding: 3px 6px;
		border-bottom: 1px solid var(--border);
		color: var(--text);
		overflow-wrap: break-word;
	}
	/* Column widths deliberately echo the 3 tab buttons' equal thirds above,
	   so the table's own vertical divisions line up with them instead of
	   bunching to the left at whatever width the cell content happens to
	   need — table-layout: fixed is what makes an explicit width here
	   actually stick regardless of content length. */
	:global(.wld-result .wld-col-1of3) {
		width: 33.333%;
	}
	:global(.wld-result .wld-col-2of3) {
		width: 66.667%;
	}
	:global(.wld-result th) {
		color: var(--muted);
		font-weight: 600;
	}
	:global(.wld-row-current) {
		background: color-mix(in srgb, var(--text) 12%, transparent);
		font-weight: 700;
	}
	:global(.wld-row-fallback) {
		background: color-mix(in srgb, var(--wld-fallback) 18%, transparent);
		font-weight: 700;
	}
	:global(.wld-row-locked) {
		color: var(--muted);
	}
	:global(.wld-tag) {
		display: inline-block;
		font-size: 10.5px;
		font-weight: 700;
		border-radius: 3px;
		padding: 0 5px;
		margin-left: 6px;
		vertical-align: 1px;
	}
	:global(.wld-tag-current) {
		background: var(--wld-ok);
		color: #16220f;
	}
	:global(html[data-theme='light']) :global(.wld-tag-current) {
		color: #dfd0b8;
	}
	:global(.wld-tag-fallback) {
		background: var(--wld-fallback);
		color: var(--wld-fallback-text);
	}
	:global(.wld-tag-locked) {
		background: var(--border);
		color: var(--bg);
	}
</style>

<script>
	type Tab = 'progression' | 'stations' | 'cargo';

	const BOSSES = [
		{ level: 1, prefab: 'Eikthyr', ward: 'ward_forest' },
		{ level: 2, prefab: 'gd_king (The Elder)', ward: 'ward_swamp' },
		{ level: 3, prefab: 'Bonemass', ward: 'ward_mountain' },
		{ level: 4, prefab: 'Dragon (Moder)', ward: 'ward_plains' },
		{ level: 5, prefab: 'GoblinKing (Yagluth)', ward: 'ward_mistlands' },
		{ level: 6, prefab: 'SeekerQueen (The Queen)', ward: 'ward_ashlands' },
		{ level: 7, prefab: 'Fader', ward: 'ward_deepnorth' },
	];

	const STATION_TIERS = [
		{ level: 0, pieces: 'Workbench, Chopping Block, Tanning Rack' },
		{ level: 1, pieces: '+ Adze; Forge, Anvils, Forge Cooler; Cauldron' },
		{ level: 2, pieces: '+ Forge Bellows, Grinding Wheel, Forge Tool Rack; Spice Rack' },
		{ level: 3, pieces: "+ Tool Shelf; Butcher's Table" },
		{ level: 4, pieces: '+ Artisan Table; Pots and Pans' },
		{ level: 5, pieces: '+ Mortar and Pestle; Galdr Table, Rune Table, Unfading Candles; Black Forge, Black Forge Cooler, Vice' },
		{ level: 6, pieces: '+ Rolling Pins and Cutting Boards; Artisan Press; Feathery Wreath; Metal Cutter, Gem Cutter' },
	];

	const CARGO_TABLE = [
		{ level: 0, villages: 0, cargo: 'none' },
		{ level: 1, villages: 4, cargo: '1–5' },
		{ level: 2, villages: 7, cargo: '1–7' },
		{ level: 3, villages: 10, cargo: '1–9' },
		{ level: 4, villages: 12, cargo: '1–9' },
		{ level: 5, villages: 14, cargo: '1–12' },
		{ level: 6, villages: 14, cargo: '1–12' },
	];

	const SUB_TEXT: Record<Tab, string> = {
		progression: "Each boss kill ratchets bfvworldlevel up to its own tier — the level never drops, even if a lower-tier boss dies after a higher one.",
		stations: 'Every crafting-station tier reads the same bfvworldlevel to decide what stays unlocked.',
		cargo: 'Eligible villages and cargo amount both scale off the same bfvworldlevel — level 6 is already the max the real script defines.',
	};

	function renderProgression(level: number): string {
		let rows = '';
		rows += `<tr class="${level === 0 ? 'wld-row-current' : ''}"><td>0${level === 0 ? '<span class="wld-tag wld-tag-current">reached</span>' : ''}</td><td>No boss killed yet</td><td>—</td></tr>`;
		for (const b of BOSSES) {
			const cls = b.level === level ? 'wld-row-current' : '';
			const tag = b.level === level ? '<span class="wld-tag wld-tag-current">reached</span>' : '';
			rows += `<tr class="${cls}"><td>${b.level}${tag}</td><td>${b.prefab}</td><td>${b.ward}</td></tr>`;
		}
		const isFallback = level === 8;
		rows += `<tr class="${isFallback ? 'wld-row-fallback' : ''}"><td>8${isFallback ? '<span class="wld-tag wld-tag-fallback">fallback</span>' : ''}</td><td colspan="2">Overflow only — no boss saves this tier in the real script</td></tr>`;
		return `<table>
			<tr><th class="wld-col-1of3">Level</th><th class="wld-col-1of3">Boss killed</th><th class="wld-col-1of3">Ward removed</th></tr>
			${rows}
		</table>`;
	}

	function renderStations(level: number): string {
		const beyondMax = level > 6;
		let rows = '';
		for (const t of STATION_TIERS) {
			const isCurrent = !beyondMax && t.level === level;
			const isFallback = beyondMax && t.level === 6;
			const unlocked = level >= t.level;
			const cls = isCurrent ? 'wld-row-current' : isFallback ? 'wld-row-fallback' : unlocked ? '' : 'wld-row-locked';
			const tag = isCurrent
				? '<span class="wld-tag wld-tag-current">current tier</span>'
				: isFallback
					? '<span class="wld-tag wld-tag-fallback">fallback</span>'
					: unlocked
						? ''
						: '<span class="wld-tag wld-tag-locked">locked</span>';
			rows += `<tr class="${cls}"><td>${t.level}${tag}</td><td>${t.pieces}</td></tr>`;
		}
		return `<table>
			<tr><th class="wld-col-1of3">Requires level</th><th class="wld-col-2of3">Unlocked pieces</th></tr>
			${rows}
		</table>`;
	}

	function renderCargo(level: number): string {
		let rows = '';
		for (const c of CARGO_TABLE) {
			const cls = (level >= 6 ? c.level === 6 : c.level === level) ? 'wld-row-current' : 'wld-row-locked';
			rows += `<tr class="${cls}"><td>${c.level}${c.level === 6 ? '–8 (max)' : ''}</td><td>${c.villages}</td><td>${c.cargo}</td></tr>`;
		}
		return `<table>
			<tr><th class="wld-col-1of3">World level</th><th class="wld-col-1of3">Eligible villages</th><th class="wld-col-1of3">Cargo amount</th></tr>
			${rows}
		</table>`;
	}

	function levelCaption(level: number): string {
		if (level === 0) return 'No boss killed yet.';
		if (level <= 7) return `Reached by killing ${BOSSES[level - 1].prefab}.`;
		return 'Above the highest tier any real boss kill can save — shown for completeness only.';
	}

	for (const widget of document.querySelectorAll<HTMLElement>('.wld-widget')) {
		const subEl = widget.querySelector<HTMLElement>('[data-sub]')!;
		const slider = widget.querySelector<HTMLInputElement>('.wld-slider')!;
		const readout = widget.querySelector<HTMLElement>('[data-readout]')!;
		const captionEl = widget.querySelector<HTMLElement>('[data-caption]')!;
		const resultEl = widget.querySelector<HTMLElement>('[data-result]')!;
		const tabs = [...widget.querySelectorAll<HTMLButtonElement>('.wld-tab')];

		const initial = widget.dataset.defaultTab as Tab | undefined;
		let tab: Tab = initial && ['progression', 'stations', 'cargo'].includes(initial) ? initial : 'progression';

		function render() {
			readout.textContent = slider.value;
			captionEl.textContent = levelCaption(Number(slider.value));
			subEl.textContent = SUB_TEXT[tab];
			tabs.forEach((t) => t.classList.toggle('wld-tab-active', t.dataset.tab === tab));
			const level = Number(slider.value);
			if (tab === 'progression') resultEl.innerHTML = renderProgression(level);
			else if (tab === 'stations') resultEl.innerHTML = renderStations(level);
			else resultEl.innerHTML = renderCargo(level);
		}

		tabs.forEach((t) =>
			t.addEventListener('click', () => {
				tab = t.dataset.tab as Tab;
				render();
			}),
		);
		slider.addEventListener('input', render);

		render();
	}
</script>
