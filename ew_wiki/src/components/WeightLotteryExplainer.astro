---
// A plain Astro component (no UI framework) — same construction pattern as
// TriggerChangeExplainer.astro / ConditionExplainer.astro: class-scoped
// (never id-scoped) so more than one instance can coexist, client-side
// <script> does the work, no client:load needed.
//
// Weight-vs-Chance tabs — mechanic confirmed against the mod's real source
// before encoding. Reading InfoManager.cs's Add() alongside InfoSelector.cs
// (ExpandWorldPrefabs) shows weight: and chance:-only rules are NOT the
// same competition with different numbers — they're two different
// selection strategies:
//   - A rule with weight: set joins one shared pool per prefab+type;
//     Randomize() picks at most one winner, proportional to weight, total
//     floored at 1.
//   - A rule with NO weight: (chance: alone) lands in a completely
//     different "Separate" bucket instead. EVERY matching rule in that
//     bucket is tried, each independently gated by its own chance: roll
//     (Manager.Handle checks info.Chance per-info, after selection) — so
//     with two such rules, both/one/neither can happen. Coins winning
//     never blocks Wood at all; they never compete.
// This is why the Chance tab runs a genuinely different simulation
// (two independent rolls, 4 possible combos) rather than the Weight
// tab's math relabeled — encoding a "chance is just weight with a cap"
// shortcut here would have taught something false.
//
// Layout is exactly two boxes, per the maintainer's own sketch (a first
// pass here mistakenly split it into three/four pieces with explicit
// grid-column/grid-row placement — that also caused a real mobile bug:
// collapsing grid-template-columns to 1fr alone wasn't enough, since a
// child's leftover explicit "grid-column: 2" made the browser invent a
// sliver 2nd column instead of stacking). The fix is structural, not a
// media-query patch: each side is ONE card containing its own two
// sub-parts, stacked internally with plain flex — no cross-card grid
// placement to keep in sync at all.
//   Left card: tabs on top, the two-rule script below.
//   Right card: the tally on top, Roll/Reset below.
// Both cards are the two items of one 1fr/1fr grid row, so they stay the
// same height via the grid's default stretch, same trick round 1 used.
//
// Known-bug guard repeated from round 1, now applying to BOTH dynamic
// panels: any element set via innerHTML/createElement in the client
// <script> — every script-line span/input AND every tally row — never
// carries Astro's scoping class, so its CSS must be :global(...) or it
// silently matches nothing. The script panel's own <input> elements are
// rebuilt only on a tab switch (not on every keystroke) specifically so
// typing in one never destroys and refocuses the element out from under
// the reader — a full re-render on 'input' would silently break typing.
---

<div class="wl-widget">
	<h4>Run the Lottery</h4>
	<p class="wl-sub" data-sub></p>

	<div class="wl-grid">
		<div class="wl-card wl-left">
			<div class="wl-tabs">
				<button type="button" class="wl-tab wl-tab-active" data-mode="weight">Weight</button>
				<button type="button" class="wl-tab" data-mode="chance">Chance</button>
			</div>
			<div class="wl-script" data-script></div>
		</div>
		<div class="wl-card wl-right">
			<div class="wl-tally" data-tally></div>
			<div class="wl-actions">
				<button type="button" class="wl-btn wl-roll-btn">Roll</button>
				<button type="button" class="wl-btn wl-reset-btn">Reset</button>
			</div>
		</div>
	</div>
</div>

<style>
	.wl-widget {
		--wl-ok: #8fbf7f;
		--wl-fail: #d98a7a;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 12px 14px;
		margin: 1rem 0;
		font-size: 13.5px;
	}
	:global(html[data-theme='light']) .wl-widget {
		--wl-ok: #2f5233;
		--wl-fail: #7a2e1f;
	}
	.wl-widget h4 {
		margin: 0 0 3px;
		font-size: 0.95em;
		color: var(--text);
	}
	.wl-sub {
		margin: 0 0 8px;
		color: var(--muted);
		font-size: 0.9em;
	}
	.wl-sub :global(code) {
		font-size: 0.95em;
	}

	.wl-tabs {
		display: flex;
		gap: 6px;
		margin: 0;
	}
	.wl-tab {
		margin: 0;
		background: var(--bg);
		border: 1px solid var(--border);
		color: var(--muted);
		border-radius: 5px;
		padding: 4px 12px;
		font-size: 12.5px;
		font-weight: 600;
		cursor: pointer;
	}
	.wl-tab:hover {
		color: var(--text);
	}
	.wl-tab.wl-tab-active {
		background: var(--bg);
		border-color: var(--text);
		color: var(--text);
	}

	/* Exactly two grid items — .wl-left and .wl-right — each a single card
	   holding its own two stacked sub-parts via plain flex. No child ever
	   carries a cross-card grid-column/grid-row placement, so collapsing
	   to one column on mobile (below) needs no per-child overrides at all;
	   a prior version placed script/tally/actions in three explicit grid
	   cells and that was a real bug on mobile — the leftover explicit
	   column made the browser invent a sliver 2nd column instead of
	   stacking. Default grid item stretch equalizes the two cards' height,
	   same trick round 1 used for the inputs/tally cards. */
	.wl-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 10px;
	}
	@media (max-width: 480px) {
		.wl-grid {
			grid-template-columns: 1fr;
		}
	}

	.wl-card {
		margin: 0;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: 5px;
		padding: 10px;
		box-sizing: border-box;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	.wl-left {
		gap: 8px;
	}
	.wl-right {
		justify-content: space-between;
		gap: 10px;
	}
	.wl-script {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 12px;
		line-height: 1.7;
		white-space: pre-wrap;
		word-break: break-word;
		color: var(--text);
	}
	.wl-tally {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 8px;
		flex: 1;
	}
	.wl-actions {
		display: flex;
		justify-content: center;
		gap: 10px;
	}

	/* :global — every rule below targets elements the client <script> builds
	   via innerHTML/createElement (script-panel spans+inputs, tally rows),
	   none of which carry Astro's own scoping class. A plain selector here
	   silently matches nothing — the exact bug round 1 hit once already. */
	:global(.wl-key) {
		color: #e6c18a;
	}
	:global(html[data-theme='light']) :global(.wl-key) {
		color: #8a5a12;
	}
	:global(.wl-inline-input) {
		margin: 0;
		width: 52px;
		background: var(--panel);
		color: var(--text);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 1px 4px;
		font-family: inherit;
		font-size: 12px;
		text-align: right;
	}
	:global(.wl-bar-row) {
		margin: 0;
	}
	/* gap:8px alongside justify-content:space-between — at this card's width
	   the longest labels ("Coins only", "Neither fires") plus their stats
	   nearly fill the row on their own, so space-between alone can leave
	   under 1px between them (measured live: 673.7px to 674.2px) even
	   though the layout itself is correct. gap guarantees real breathing
	   room regardless of how tight the fit is. */
	:global(.wl-bar-label) {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 8px;
		margin: 0 0 3px;
		font-size: 11.5px;
	}
	:global(.wl-bar-label .wl-name) {
		font-family: monospace;
		color: var(--text);
		flex: none;
	}
	:global(.wl-bar-label .wl-nums) {
		color: var(--muted);
		text-align: right;
	}
	:global(.wl-bar-track) {
		margin: 0;
		background: var(--panel);
		border: 1px solid var(--border);
		border-radius: 4px;
		height: 13px;
		min-height: 13px;
		overflow: hidden;
		position: relative;
	}
	:global(.wl-bar-fill) {
		height: 100%;
		background: var(--wl-ok);
		width: 0%;
		transition: width 0.15s linear;
	}
	:global(.wl-bar-fill.wl-gap) {
		background: var(--wl-fail);
	}
	/* A thin flex-sized marker inside the same flex row as the fill, not an
	   absolute-position offset — sized as a track overlay via inset so it
	   stays exactly 2px wide regardless of the fill's own width. */
	:global(.wl-bar-tick) {
		position: absolute;
		inset: 0 auto 0 0;
		width: 2px;
		background: var(--text);
		opacity: 0.6;
	}

	.wl-btn {
		margin: 0;
		width: 84px;
		height: 30px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 4px;
		background: var(--panel);
		border: 1px solid var(--border);
		color: var(--text);
		border-radius: 6px;
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
	}
	.wl-btn:hover {
		border-color: var(--text);
	}
	.wl-btn:disabled {
		opacity: 0.5;
		cursor: default;
	}
</style>

<script>
	type Mode = 'weight' | 'chance';

	const SUB_TEXT: Record<Mode, string> = {
		weight: "Set each rule's weight: — exactly one of them ever wins (or neither, if they don't add up to 1).",
		chance: "Set each rule's chance: — each one rolls on its own. You can get both, one, or neither.",
	};

	const clamp01 = (v: number) => Math.max(0, Math.min(1, v));

	for (const widget of document.querySelectorAll<HTMLElement>('.wl-widget')) {
		const subEl = widget.querySelector<HTMLElement>('[data-sub]')!;
		const scriptEl = widget.querySelector<HTMLElement>('[data-script]')!;
		const tallyEl = widget.querySelector<HTMLElement>('[data-tally]')!;
		const tabs = [...widget.querySelectorAll<HTMLButtonElement>('.wl-tab')];
		const rollBtn = widget.querySelector<HTMLButtonElement>('.wl-roll-btn')!;
		const resetBtn = widget.querySelector<HTMLButtonElement>('.wl-reset-btn')!;

		const DEFAULTS = [0.3, 0.2];
		const LABELS = ['Coins', 'Wood'];

		let mode: Mode = 'weight';
		let values = [...DEFAULTS];
		let counts: Record<string, number> = {};
		let rolled = 0;
		let timer: ReturnType<typeof setInterval> | null = null;

		// Rebuilds the script panel's inputs — only called on a tab switch,
		// never on the inputs' own 'input' event, so typing never destroys
		// and refocuses the field out from under the reader.
		function renderScript() {
			const key = mode === 'weight' ? 'weight' : 'chance';
			const line = (val: number, idx: number, prefab: string) => `<span class="wl-key">- prefab:</span> Neck
<span class="wl-key">  type:</span> destroy
<span class="wl-key">  ${key}:</span> <input type="number" step="0.1" min="0" class="wl-inline-input" data-idx="${idx}" value="${val}" />
<span class="wl-key">  spawn:</span>
<span class="wl-key">  - prefab:</span> ${prefab}`;
			scriptEl.innerHTML = line(values[0], 0, 'Coins') + '\n\n' + line(values[1], 1, 'Wood');
			scriptEl.querySelectorAll<HTMLInputElement>('.wl-inline-input').forEach((inp) => {
				inp.addEventListener('input', () => {
					const idx = Number(inp.dataset.idx);
					values[idx] = Math.max(0, parseFloat(inp.value) || 0);
					resetTally();
					renderTally();
				});
			});
		}

		function resetTally() {
			counts = {};
			rolled = 0;
		}

		function weightTheory() {
			const total = Math.max(1, values[0] + values[1]);
			const gap = Math.max(0, total - (values[0] + values[1]));
			return { total, rows: [{ label: LABELS[0], p: values[0] / total }, { label: LABELS[1], p: values[1] / total }, { label: 'Nothing happened', p: gap / total, isGap: true }] };
		}

		function chanceTheory() {
			const pC = clamp01(values[0]);
			const pW = clamp01(values[1]);
			return {
				rows: [
					{ label: 'Both fire', p: pC * pW, isGap: false },
					{ label: 'Coins only', p: pC * (1 - pW), isGap: false },
					{ label: 'Wood only', p: (1 - pC) * pW, isGap: false },
					{ label: 'Neither fires', p: (1 - pC) * (1 - pW), isGap: true },
				],
			};
		}

		function renderTally() {
			const rows = mode === 'weight' ? weightTheory().rows : chanceTheory().rows;
			tallyEl.innerHTML = '';
			for (const row of rows) {
				const count = counts[row.label] ?? 0;
				const actualPct = rolled ? (count / rolled) * 100 : 0;
				const theoreticalPct = row.p * 100;

				const rowEl = document.createElement('div');
				rowEl.className = 'wl-bar-row';

				const labelRow = document.createElement('div');
				labelRow.className = 'wl-bar-label';
				const nameSpan = document.createElement('span');
				nameSpan.className = 'wl-name';
				nameSpan.textContent = row.label;
				const numsSpan = document.createElement('span');
				numsSpan.className = 'wl-nums';
				numsSpan.textContent = `${actualPct.toFixed(0)}% actual · ${theoreticalPct.toFixed(0)}% expected`;
				labelRow.append(nameSpan, numsSpan);

				const track = document.createElement('div');
				track.className = 'wl-bar-track';
				const fill = document.createElement('div');
				fill.className = 'wl-bar-fill' + (row.isGap ? ' wl-gap' : '');
				fill.style.width = actualPct + '%';
				const tick = document.createElement('div');
				tick.className = 'wl-bar-tick';
				tick.style.left = theoreticalPct + '%';
				track.append(fill, tick);

				rowEl.append(labelRow, track);
				tallyEl.appendChild(rowEl);
			}
		}

		// Mirrors ExpandWorldPrefabs/InfoSelector.cs Randomize(): the pool's
		// total floors at 1, so a pool under 1 leaves a real gap.
		function rollWeightOnce(): string {
			const total = Math.max(1, values[0] + values[1]);
			let r = Math.random() * total;
			for (let i = 0; i < 2; i++) {
				r -= values[i];
				if (r <= 0) return LABELS[i];
			}
			return 'Nothing happened';
		}

		// Mirrors the mod's "Separate" bucket: no shared pool, each rule
		// rolls its own chance independently — both, one, or neither can win.
		function rollChanceOnce(): string {
			const coinsHit = Math.random() < clamp01(values[0]);
			const woodHit = Math.random() < clamp01(values[1]);
			if (coinsHit && woodHit) return 'Both fire';
			if (coinsHit) return 'Coins only';
			if (woodHit) return 'Wood only';
			return 'Neither fires';
		}

		function rollBatch() {
			rollBtn.disabled = true;
			timer = setInterval(() => {
				for (let k = 0; k < 5 && rolled < 100; k++) {
					const label = mode === 'weight' ? rollWeightOnce() : rollChanceOnce();
					counts[label] = (counts[label] ?? 0) + 1;
					rolled++;
				}
				renderTally();
				if (rolled >= 100) {
					if (timer) clearInterval(timer);
					rollBtn.disabled = false;
				}
			}, 80);
		}

		function reset() {
			if (timer) clearInterval(timer);
			rollBtn.disabled = false;
			values = [...DEFAULTS];
			resetTally();
			renderScript();
			renderTally();
		}

		function setMode(next: Mode) {
			if (timer) clearInterval(timer);
			rollBtn.disabled = false;
			mode = next;
			tabs.forEach((t) => t.classList.toggle('wl-tab-active', t.dataset.mode === mode));
			subEl.textContent = SUB_TEXT[mode];
			resetTally();
			renderScript();
			renderTally();
		}

		tabs.forEach((t) => t.addEventListener('click', () => setMode(t.dataset.mode as Mode)));
		rollBtn.addEventListener('click', rollBatch);
		resetBtn.addEventListener('click', reset);

		setMode('weight');
	}
</script>
