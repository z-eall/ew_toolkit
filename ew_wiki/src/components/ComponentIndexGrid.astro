---
// A plain, evenly-spaced jump-link grid for a page's "every X grouped by
// component" index — used on object-ownership.mdx. Row count is whatever
// falls out of `items.length` and `columns`; the caller passes as many
// items as it has, no padding to a fixed cell count.
interface Item {
	href: string;
	label: string;
}
interface Props {
	items: Item[];
	columns?: number;
}
const { items, columns = 5 } = Astro.props;
---

<div class="cig-grid" style={`grid-template-columns: repeat(${columns}, 1fr);`}>
	{items.map((item) => (
		<a href={item.href}>{item.label}</a>
	))}
</div>

<style>
	.cig-grid {
		display: grid;
		gap: 0.5rem;
		margin: 0.75rem 0 1.25rem;
	}
	.cig-grid a {
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: 0.6rem 0.5rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.375rem;
		font-size: 0.85em;
		line-height: 1.3;
	}
	@media (max-width: 640px) {
		.cig-grid {
			grid-template-columns: repeat(2, 1fr) !important;
		}
	}
</style>
