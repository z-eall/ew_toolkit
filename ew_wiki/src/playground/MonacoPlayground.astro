---
// A plain Astro component (no UI framework) embedding a Monaco + monaco-yaml
// editor. Astro ships a component's <script> tag to the client and bundles
// it through Vite automatically -- no client:load/client:only directive is
// needed for that; those directives are only for framework (React/Vue/etc.)
// components. See this ticket's Answer for the full note.
//
// `seed` is the starting YAML shown in the editor; `id` lets more than one
// playground live on a page without colliding.
interface Props {
	id?: string;
	seed: string;
}
const { id = 'ewp-playground', seed } = Astro.props;
---

<div class="ewp-playground">
	<div class="ewp-playground-toolbar">
		<span>Try it — live schema validation</span>
	</div>
	<div id={id} class="ewp-playground-editor" data-seed={seed}></div>
</div>

<style>
	.ewp-playground {
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		overflow: hidden;
		margin: 1.5rem 0;
	}
	.ewp-playground-toolbar {
		background: var(--sl-color-gray-6);
		color: var(--sl-color-gray-2);
		font-size: 0.8rem;
		padding: 0.4rem 0.8rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
	}
	.ewp-playground-editor {
		height: 320px;
	}
</style>

<script>
	import * as monaco from 'monaco-editor';
	import editorWorker from 'monaco-editor/esm/vs/editor/editor.worker?worker';
	import { configureMonacoYaml } from 'monaco-yaml';
	import yamlWorker from 'monaco-yaml/yaml.worker?worker';
	import schemaJson from './schema.generated.json';

	(self as unknown as { MonacoEnvironment: import('monaco-editor').Environment }).MonacoEnvironment = {
		getWorker(_moduleId: string, label: string) {
			if (label === 'yaml') return new yamlWorker();
			return new editorWorker();
		},
	};

	// Prototype simplification (see this ticket's Answer): the real validator
	// runs monaco-yaml with validate: false and does its own structural
	// pre-check (a bigger, separate mechanism) to produce errors. This
	// playground turns monaco-yaml's own `validate: true` on instead, so it
	// shows real but less finely-tuned live schema errors with far less wiring.
	configureMonacoYaml(monaco, {
		validate: true,
		hover: true,
		completion: true,
		schemas: [
			{
				uri: 'inmemory://ewp-toolkit/schema.json',
				fileMatch: ['**/*.yaml', '**/*.yml'],
				schema: schemaJson as unknown as Record<string, unknown>,
			},
		],
	});

	const isDark = () => document.documentElement.getAttribute('data-theme') !== 'light';

	for (const container of document.querySelectorAll<HTMLDivElement>('.ewp-playground-editor')) {
		const model = monaco.editor.createModel(container.dataset.seed ?? '', 'yaml', monaco.Uri.parse(`file:///${container.id}.yaml`));
		monaco.editor.create(container, {
			model,
			theme: isDark() ? 'vs-dark' : 'vs',
			automaticLayout: true,
			minimap: { enabled: false },
			fontSize: 13,
		});
	}

	// Starlight toggles data-theme on <html> when the reader switches
	// light/dark; monaco.editor.setTheme is global, so one observer covers
	// every editor on the page.
	new MutationObserver(() => monaco.editor.setTheme(isDark() ? 'vs-dark' : 'vs')).observe(document.documentElement, {
		attributes: true,
		attributeFilter: ['data-theme'],
	});
</script>
