{
  "name": "ewp-validator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate-schema": "node schema/generate.mjs",
    "dev": "npm run generate-schema && vite",
    "build": "npm run generate-schema && vite build",
    "preview": "vite preview",
    "pretest": "npm run generate-schema",
    "test": "vitest run",
    "build:cli": "npm run generate-schema && esbuild src/cli.ts --bundle --packages=external --platform=node --format=esm --outfile=dist/cli.mjs",
    "validate": "npm run build:cli && node dist/cli.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "monaco-editor": "^0.52.0",
    "monaco-yaml": "^5.2.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
